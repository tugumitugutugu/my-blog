---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="ja">
<head>
<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
<Header />
<main>
<section class="hero">
<h1>つぐぶろぐ</h1>
<p>青森の雪国から、暮らしのお気に入りや日常をお届けしています。</p>
</section>

<h2 class="section-title">最新の記事</h2>
<ul class="card-grid">
{
  posts.map((post) => (
    <li class="card">
      <a href={`/blog/${post.id}/`}>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <h3>{post.data.title}</h3>
        {post.data.description && <p class="excerpt">{post.data.description}</p>}
      </a>
    </li>
  ))
}
</ul>
</main>
<Footer />
</body>
</html>

<style>
.hero {
  background: #e1f5ee;
  border-radius: 16px;
  padding: 2rem 1.5rem;
  margin-bottom: 2.5rem;
}
.hero h1 {
  margin: 0 0 0.5rem;
  color: #5a4638;
}
.hero p {
  margin: 0;
  color: #6b5445;
  line-height: 1.7;
}
.section-title {
  margin: 0 0 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #e1f5ee;
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  list-style: none;
  padding: 0;
  margin: 0;
}
.card {
  border: 1px solid #eee;
  border-left: 3px solid #6ed3ba;
  border-radius: 8px;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.card:hover {
  box-shadow: 0 4px 14px rgba(110, 211, 186, 0.25);
  transform: translateY(-2px);
}
.card a {
  display: block;
  padding: 1rem 1.2rem;
  text-decoration: none;
  color: inherit;
}
.card time {
  font-size: 0.8rem;
  color: #999;
}
.card h3 {
  margin: 0.4rem 0 0.5rem;
  font-size: 1.05rem;
  line-height: 1.5;
  color: #333;
}
.card .excerpt {
  margin: 0;
  font-size: 0.85rem;
  line-height: 1.6;
  color: #777;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
@media (max-width: 600px) {
  .card-grid {
    grid-template-columns: 1fr;
  }
}
</style>

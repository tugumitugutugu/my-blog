---
interface Props {
	adSlot?: string;
}

const { adSlot = '5599184296' } = Astro.props;
---

<div class="ad-slot">
	<p class="ad-label">スポンサーリンク</p>
	<ins
		class="adsbygoogle"
		style="display:block"
		data-ad-client="ca-pub-2459623226352141"
		data-ad-slot={adSlot}
		data-ad-format="auto"
		data-full-width-responsive="true"></ins>
</div>

<script is:inline>
	(adsbygoogle = window.adsbygoogle || []).push({});
</script>

<style>
	.ad-slot {
		margin: 2.5em 0;
		text-align: center;
	}
	.ad-label {
		margin: 0 0 0.4em;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		color: #aaa;
	}
</style>

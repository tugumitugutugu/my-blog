---
const today = new Date();
---

<footer>
	<nav class="footer-links">
		<a href="/">ホーム</a>
		<span class="sep">|</span>
		<a href="/blog">記事一覧</a>
		<span class="sep">|</span>
		<a href="/about">つぐぶろぐについて</a>
		<span class="sep">|</span>
		<a href="/contact">お問い合わせ</a>
		<span class="sep">|</span>
		<a href="/privacy-policy">プライバシーポリシー</a>
	</nav>
	<div class="copyright">&copy; {today.getFullYear()} つぐみ. All rights reserved.</div>
</footer>
<button id="to-top" aria-label="ページの上部へ戻る">↑</button>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: var(--choco);
		color: #e3d8cd;
		text-align: center;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.6em;
		flex-wrap: wrap;
		font-size: 0.9em;
	}
	.footer-links a {
		color: var(--accent);
		text-decoration: none;
		font-weight: bold;
	}
	.footer-links a:hover {
		color: #fff;
		text-decoration: underline;
	}
	.sep {
		color: rgba(243, 236, 229, 0.4);
		user-select: none;
	}
	.copyright {
		font-size: 0.85em;
		margin-top: 1.2em;
	}
	#to-top {
		position: fixed;
		right: 1.2em;
		bottom: 1.2em;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		border: none;
		background: var(--accent);
		color: #fff;
		font-size: 1.3em;
		cursor: pointer;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.3s, visibility 0.3s;
		z-index: 100;
	}
	#to-top.show {
		opacity: 0.9;
		visibility: visible;
	}
	#to-top:hover {
		background: var(--accent-dark);
	}
</style>
<script is:inline>
	(function () {
		var btn = document.getElementById("to-top");
		if (!btn) return;
		window.addEventListener("scroll", function () {
			if (window.scrollY > 300) { btn.classList.add("show"); } else { btn.classList.remove("show"); }
		}, { passive: true });
		btn.addEventListener("click", function () {
			window.scrollTo({ top: 0, behavior: "smooth" });
		});
	})();
</script>
